{
  "name": "@hooman-studio/admin-ui",
  "version": "0.3.1",
  "description": "Hooman Studio building blocks for client admin panels, styled with the Hooman Studio design system on UI SDK behaviors.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoooman-Studio/admin-ui.git"
  },
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "setup.md"
  ],
  "scripts": {
    "api": "rm -rf api && mkdir api && cp dist/*.d.ts api/ && biome check --write api",
    "build": "rm -rf dist && tsdown && tailwindcss -i src/styles.css -o dist/styles.css --minify && cp -R src/fonts dist/fonts && sed -e 's#@source \"./components\";#@source \"./\";#' -e '/@source \"\\.\\/patterns\";/d' -e '/@source \"\\.\\/form\\.tsx\";/d' src/styles.css > dist/tailwind.css && bun run api",
    "check": "bun run typecheck && bun run lint && bun run fallow && bun run test && bun run build",
    "dev": "vite playground",
    "fallow": "fallow dead-code",
    "format": "biome check --write",
    "lint": "biome check",
    "prepublishOnly": "bun run check",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.6",
    "@ui-sdk/react": "0.1.0-beta.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fallow": "^3.43.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "ultracite": "^8.2.1",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-form": "^1.33.0",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-form": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
