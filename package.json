{
  "name": "@hooman-studio/admin-ui",
  "version": "0.0.0",
  "description": "Hooman Studio building blocks for client admin panels, styled with the Hooman Studio design system on UI SDK behaviors.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hoooman-Studio/admin-ui.git"
  },
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./styles.css": "./styles/styles.css",
    "./fonts.css": "./styles/fonts.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run typecheck && bun run lint && bun run fallow && bun run test && bun run build",
    "dev": "vite playground",
    "fallow": "fallow dead-code",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.6",
    "@ui-sdk/react": "0.1.0-beta.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fallow": "^3.43.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "ultracite": "^8.2.1",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-form": ">=1.33",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-form": {
      "optional": true
    }
  }
}
